# Copy to .env (never commit .env). Read by the Python backend only - the frontend never sees these keys.

# ---- Google Gemini AI (Priority 1) ----------------------------------------
# Generate a free key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
FRONTEND_ORIGIN=https://dl-chatbot-eaugtsjva-hfy3.vercel.app

# ---- server ---------------------------------------------------------------
VISION_HOST=127.0.0.1            # use 0.0.0.0 only inside Docker / behind a reverse proxy
VISION_PORT=5001                 # not 5000: macOS AirPlay Receiver uses it
VISION_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional shared secret for server-to-server or desktop->remote use. NOTE: a token baked into a public web
# bundle is not secret; for a public site rely on HTTPS + rate limiting + auth at the reverse proxy.
VISION_API_TOKEN=
VISION_TRUST_PROXY=0             # 1 when behind Caddy/nginx so rate limits use the real client IP
VISION_RATE_LIMIT_PER_MIN=120
VISION_MAX_UPLOAD_MB=12

# ---- vision ---------------------------------------------------------------
VISION_YOLO_WEIGHTS=yolov8n.pt   # downloaded once on first run (needs internet once), then fully offline
VISION_CONFIDENCE=0.35
VISION_PREFER_YOLO=1

# ---- language model + online knowledge -------------------------------------
# Leave keys empty to run entirely on local logic (object Q&A still works; open-ended chat is limited).
ANTHROPIC_API_KEY=
VISION_LLM_MODEL=claude-sonnet-5-5
# Or an OpenAI-compatible endpoint:
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
VISION_LLM_PROVIDER=             # anthropic | openai (auto-detected from whichever key is set)
VISION_ENABLE_RAG=1              # Wikipedia lookups for factual questions
VISION_OFFLINE=0                 # 1 = never call the network (no LLM, no Wikipedia)

# ---- voice ----------------------------------------------------------------
VISION_WHISPER_MODEL=base        # tiny | base | small | medium  (bigger = more accurate, slower)
VISION_PIPER_MODEL=              # path to a Piper .onnx voice, e.g. /Users/me/piper/en_US-amy-medium.onnx
VISION_PIPER_MODEL_EN=           # optional English voice; falls back to VISION_PIPER_MODEL
VISION_PIPER_MODEL_HI=           # optional Hindi voice; use a model trained for Hindi
VISION_PIPER_MODEL_PA=           # optional Punjabi voice; use a model trained for Punjabi
