{
  "name": "vision-desktop",
  "productName": "VISION",
  "version": "1.0.0",
  "private": true,
  "description": "VISION desktop shell (Electron) - runs the shared Flask backend locally and the shared React frontend",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.example.vision",
    "productName": "VISION",
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!.venv/**",
          "!**/__pycache__/**",
          "!tests/**",
          "!models/cifar10/**",
          "!.pytest_cache/**"
        ]
      },
      {
        "from": "../frontend/dist",
        "to": "frontend/dist"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "VISION uses the camera only when you turn it on, to detect objects and answer questions about them.",
        "NSMicrophoneUsageDescription": "VISION uses the microphone only when you turn it on, to hear your questions."
      }
    }
  }
}
